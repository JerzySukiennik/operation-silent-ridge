; Engine configuration file.

config_version=5

[application]

config/name="Operation Silent Ridge"
config/description="Co-op carrier strike: F-35C, low-level canyon ingress, laser-guided bombs."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.04, 0.05, 0.07, 1)
boot_splash/minimum_display_time=0

[autoload]

Net="*res://scripts/net/net.gd"
Controls="*res://scripts/flight/controls.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

scaling_3d/mode=2
scaling_3d/scale=0.67
anti_aliasing/quality/screen_space_aa=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=3
anti_aliasing/quality/use_debanding=true
reflections/sky_reflections/texture_array_reflections=false
